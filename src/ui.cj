package cangjie_learning_agent

import std.fs.*

func buildDashboardHtml(officialCount: Int64, userNotesCount: Int64, officialCharacters: Int64, userNotesCharacters: Int64): String {
    var html = "<!doctype html>\n"
    html += "<html lang='en'>\n"
    html += "<head>\n"
    html += "<meta charset='utf-8'>\n"
    html += "<meta name='viewport' content='width=device-width, initial-scale=1'>\n"
    html += "<title>Cangjie Learning Agent Dashboard</title>\n"
    html += "<style>\n"
    html += "body{margin:0;font-family:Segoe UI,Arial,sans-serif;background:#f5f7fb;color:#17252f}main{max-width:1120px;margin:0 auto;padding:32px}header{padding:28px 0 18px}h1{margin:0;font-size:34px}p{line-height:1.65}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.card{background:#fff;border:1px solid #dce4ea;border-radius:8px;padding:18px}.num{font-size:30px;font-weight:800;color:#1d5f76}.section{margin-top:22px}.cmd{font-family:Consolas,monospace;background:#edf3f7;border-radius:6px;padding:10px;margin:8px 0}.tag{display:inline-block;background:#e7f4ee;color:#1b6b46;border:1px solid #b9dec9;border-radius:999px;padding:4px 10px;margin:4px 6px 4px 0}@media(max-width:800px){.grid{grid-template-columns:1fr 1fr}main{padding:20px}}@media(max-width:520px){.grid{grid-template-columns:1fr}h1{font-size:28px}}\n"
    html += "</style>\n"
    html += "</head>\n"
    html += "<body>\n"
    html += "<main>\n"
    html += "<header>\n"
    html += "<h1>Cangjie Learning Agent Dashboard</h1>\n"
    html += "<p>A source-backed beginner assistant implemented in Cangjie. It searches local .md/.txt knowledge, answers syntax questions, exports reports, and prepares LLM request drafts without storing API keys.</p>\n"
    html += "<span class='tag'>Implementation: Cangjie</span><span class='tag'>Local knowledge base</span><span class='tag'>Source-backed answers</span><span class='tag'>Static web dashboard</span>\n"
    html += "</header>\n"
    html += "<section class='grid'>\n"
    html += "<div class='card'><div>Official files</div><div class='num'>${officialCount}</div></div>\n"
    html += "<div class='card'><div>User files</div><div class='num'>${userNotesCount}</div></div>\n"
    html += "<div class='card'><div>Official chars</div><div class='num'>${officialCharacters}</div></div>\n"
    html += "<div class='card'><div>User chars</div><div class='num'>${userNotesCharacters}</div></div>\n"
    html += "</section>\n"
    html += "<section class='section card'>\n"
    html += "<h2>Main workflow</h2>\n"
    html += "<p>Import or add local knowledge, retrieve matched sources, generate source-backed answers, and export review artifacts for classroom acceptance.</p>\n"
    html += "<div class='cmd'>target\\manual\\main.exe ask match</div>\n"
    html += "<div class='cmd'>target\\manual\\main.exe card ArrayList</div>\n"
    html += "<div class='cmd'>target\\manual\\main.exe export-answer match_answer match</div>\n"
    html += "<div class='cmd'>target\\manual\\main.exe llm-request match</div>\n"
    html += "</section>\n"
    html += "<section class='section grid'>\n"
    html += "<div class='card'><h3>Knowledge</h3><p>Official/course notes, syntax notes, examples, and error notes are scanned recursively from local files.</p></div>\n"
    html += "<div class='card'><h3>Retrieval</h3><p>Full query matches receive higher scores, and word-level fallback keeps multi-word questions useful.</p></div>\n"
    html += "<div class='card'><h3>LLM API</h3><p>The llm-ask command sends local source context to an OpenAI-compatible API through Cangjie orchestration.</p></div>\n"
    html += "<div class='card'><h3>Acceptance</h3><p>Reports, indexes, source maps, sessions, and study cards can be exported for teacher review.</p></div>\n"
    html += "</section>\n"
    html += "</main>\n"
    html += "</body>\n"
    html += "</html>\n"
    return html
}

func exportDashboard(name: String, officialCount: Int64, userNotesCount: Int64, officialCharacters: Int64, userNotesCharacters: Int64): Path {
    let path = Path("docs").join(name + ".html")
    File.writeTo(path, buildDashboardHtml(officialCount, userNotesCount, officialCharacters, userNotesCharacters).toArray())
    return path
}

func printDashboardSummary(officialCount: Int64, userNotesCount: Int64, officialCharacters: Int64, userNotesCharacters: Int64): Unit {
    println("Dashboard summary:")
    println("- implementation language: Cangjie")
    println("- web artifact: static HTML generated by Cangjie")
    println("- official files: ${officialCount}")
    println("- user files: ${userNotesCount}")
    println("- official characters: ${officialCharacters}")
    println("- user characters: ${userNotesCharacters}")
    println("- suggested export: target\\manual\\main.exe export-dashboard dashboard")
}

func buildFinalCheckReport(officialCount: Int64, userNotesCount: Int64, officialCharacters: Int64, userNotesCharacters: Int64): String {
    var text = "# Cangjie Learning Agent Final Check\n\n"
    text += "## Scope\n\n"
    text += "- Target user: Cangjie beginners\n"
    text += "- Implementation language: Cangjie\n"
    text += "- Knowledge format: local .md and .txt files\n"
    text += "- UI direction: static web dashboard generated by Cangjie\n\n"
    text += "## Acceptance Coverage\n\n"
    text += "- Import/add knowledge: implemented\n"
    text += "- Retrieve local sources: implemented\n"
    text += "- Answer syntax questions with sources: implemented\n"
    text += "- Generate examples, practice, quizzes, cards, and sessions: implemented\n"
    text += "- Mark primary source and source context: implemented\n"
    text += "- LLM API: llm-ask live request, request draft, and response archive implemented\n"
    text += "- Web/dashboard artifact: implemented\n\n"
    text += "## Knowledge Stats\n\n"
    text += "- Official files: ${officialCount}\n"
    text += "- User files: ${userNotesCount}\n"
    text += "- Official characters: ${officialCharacters}\n"
    text += "- User characters: ${userNotesCharacters}\n\n"
    text += "## Remaining Manual Items\n\n"
    text += "- Live-test `llm-ask` after setting a valid model and API key.\n"
    text += "- Optionally replace curl transport if a high-level Cangjie HTTPS JSON client becomes available.\n"
    text += "- Open `docs/dashboard.html` in a browser for visual classroom display.\n"
    text += "- Optionally convert teacher PDFs to .md/.txt before importing searchable content.\n"
    return text
}

func printFinalCheck(officialCount: Int64, userNotesCount: Int64, officialCharacters: Int64, userNotesCharacters: Int64): Unit {
    println(buildFinalCheckReport(officialCount, userNotesCount, officialCharacters, userNotesCharacters))
}

func exportFinalCheck(name: String, officialCount: Int64, userNotesCount: Int64, officialCharacters: Int64, userNotesCharacters: Int64): Path {
    let path = Path("docs").join(name + ".md")
    File.writeTo(path, buildFinalCheckReport(officialCount, userNotesCount, officialCharacters, userNotesCharacters).toArray())
    return path
}

func buildTraceReport(topic: String, totalMatches: Int64, officialScore: Int64, userNotesScore: Int64, primarySource: String, sourceText: String): String {
    var text = "# Cangjie Learning Agent Trace: ${topic}\n\n"
    text += "## Trace Steps\n\n"
    text += "1. Receive user topic or question: `${topic}`.\n"
    text += "2. Search official/course knowledge and user notes.\n"
    text += "3. Score complete-query matches higher than word-level fallback matches.\n"
    text += "4. Select the primary source with the highest local score.\n"
    text += "5. Build a source-backed answer, card, session, or LLM request draft.\n"
    text += "6. Keep the source path visible for classroom review.\n\n"
    text += "## Retrieval Result\n\n"
    text += "- Total matches: ${totalMatches}\n"
    text += "- Best official/course score: ${officialScore}\n"
    text += "- Best user notes score: ${userNotesScore}\n"
    if (!primarySource.isEmpty()) {
        text += "- Primary source: ${primarySource}\n\n"
    } else {
        text += "- Primary source: none\n\n"
    }
    text += "## Source Context\n\n"
    if (!sourceText.isEmpty()) {
        text += "````text\n"
        text += sourceText
        text += "\n````\n\n"
    } else {
        text += "No source context is available. Add or import .md/.txt knowledge first.\n\n"
    }
    text += "## Engineering Notes\n\n"
    text += "- The trace is generated by Cangjie code.\n"
    text += "- It explains why the selected source is used.\n"
    text += "- It supports the project requirement that answers must mark their sources.\n"
    return text
}

func printTraceReport(topic: String, totalMatches: Int64, officialScore: Int64, userNotesScore: Int64, primarySource: String, sourceText: String): Unit {
    println(buildTraceReport(topic, totalMatches, officialScore, userNotesScore, primarySource, sourceText))
}

func exportTraceReport(name: String, topic: String, totalMatches: Int64, officialScore: Int64, userNotesScore: Int64, primarySource: String, sourceText: String): Path {
    let path = Path("docs").join(name + ".md")
    File.writeTo(path, buildTraceReport(topic, totalMatches, officialScore, userNotesScore, primarySource, sourceText).toArray())
    return path
}

func buildRoadmapReport(): String {
    var text = "# Cangjie Learning Agent Roadmap\n\n"
    text += "## Completed Core\n\n"
    text += "- Local .md/.txt knowledge import and add commands.\n"
    text += "- Source-backed retrieval, scoring, primary source selection, and source context display.\n"
    text += "- Beginner answer, example, practice, quiz, study card, and learning session commands.\n"
    text += "- LLM request draft workflow, live llm-ask command, and local response archive.\n"
    text += "- Static dashboard, final check, trace, and export reports generated by Cangjie.\n\n"
    text += "## Remaining Work\n\n"
    text += "1. Live-test `llm-ask` after setting a valid API key and model.\n"
    text += "2. Optionally replace curl transport if a high-level Cangjie HTTPS JSON client becomes available.\n"
    text += "3. Optionally make the static dashboard interactive or wrap the CLI in a desktop shell.\n"
    text += "4. Convert more teacher PDF content into .md/.txt notes for richer local retrieval.\n\n"
    text += "## Recommended Demo Order\n\n"
    text += "1. `self-check`\n"
    text += "2. `source-map`\n"
    text += "3. `trace match`\n"
    text += "4. `ask match`\n"
    text += "5. `llm-status`\n"
    text += "6. `llm-ask match`\n"
    text += "7. `export-dashboard dashboard`\n"
    text += "8. `final-check`\n"
    return text
}

func printRoadmap(): Unit {
    println(buildRoadmapReport())
}

func exportRoadmap(name: String): Path {
    let path = Path("docs").join(name + ".md")
    File.writeTo(path, buildRoadmapReport().toArray())
    return path
}

func buildCommandSheetReport(): String {
    var text = "# Cangjie Learning Agent Command Sheet\n\n"
    text += "## Build\n\n"
    text += "```powershell\n"
    text += "cjc -p src --output-dir target\\manual\n"
    text += "```\n\n"
    text += "## Core Demo\n\n"
    text += "```powershell\n"
    text += "target\\manual\\main.exe help\n"
    text += "target\\manual\\main.exe self-check\n"
    text += "target\\manual\\main.exe source-map\n"
    text += "target\\manual\\main.exe trace match\n"
    text += "target\\manual\\main.exe ask match\n"
    text += "target\\manual\\main.exe card ArrayList\n"
    text += "target\\manual\\main.exe llm-request match\n"
    text += "target\\manual\\main.exe dashboard\n"
    text += "target\\manual\\main.exe final-check\n"
    text += "```\n\n"
    text += "## Export Demo\n\n"
    text += "```powershell\n"
    text += "target\\manual\\main.exe export-answer match_answer match\n"
    text += "target\\manual\\main.exe export-session arraylist_session ArrayList\n"
    text += "target\\manual\\main.exe export-card arraylist_card ArrayList\n"
    text += "target\\manual\\main.exe export-llm-request match_llm_request match\n"
    text += "target\\manual\\main.exe export-dashboard dashboard\n"
    text += "target\\manual\\main.exe export-final-check final_check\n"
    text += "target\\manual\\main.exe export-trace match_trace match\n"
    text += "target\\manual\\main.exe export-roadmap roadmap\n"
    text += "target\\manual\\main.exe export-delivery-index delivery_index\n"
    text += "```\n\n"
    text += "## Personal Knowledge\n\n"
    text += "```powershell\n"
    text += "target\\manual\\main.exe add-note my_note Cangjie personal syntax note\n"
    text += "target\\manual\\main.exe import-note imported_note docs\\knowledge_base.md\n"
    text += "target\\manual\\main.exe sources ArrayList\n"
    text += "target\\manual\\main.exe show-source ArrayList\n"
    text += "```\n"
    return text
}

func printCommandSheet(): Unit {
    println(buildCommandSheetReport())
}

func exportCommandSheet(name: String): Path {
    let path = Path("docs").join(name + ".md")
    File.writeTo(path, buildCommandSheetReport().toArray())
    return path
}

func buildDeliveryIndexReport(officialCount: Int64, userNotesCount: Int64, officialCharacters: Int64, userNotesCharacters: Int64): String {
    var text = "# Cangjie Learning Agent Delivery Index\n\n"
    text += "## Project Snapshot\n\n"
    text += "- Implementation language: Cangjie\n"
    text += "- Official/course files: ${officialCount}\n"
    text += "- User knowledge files: ${userNotesCount}\n"
    text += "- Official/course characters: ${officialCharacters}\n"
    text += "- User knowledge characters: ${userNotesCharacters}\n\n"
    text += "## Key Source Files\n\n"
    text += "- `src/main.cj`: CLI routing and command orchestration\n"
    text += "- `src/knowledge.cj`: local .md/.txt knowledge scanning, search, import, and scoring\n"
    text += "- `src/agent.cj`: source-backed answers, examples, quizzes, sessions, and cards\n"
    text += "- `src/prompt.cj`: LLM prompt and request draft generation\n"
    text += "- `src/config.cj`: environment variable based LLM configuration checks\n"
    text += "- `src/llm.cj`: OpenAI-compatible live API request and response extraction\n"
    text += "- `src/ui.cj`: dashboard, final check, trace, roadmap, and delivery reports\n\n"
    text += "## Main Delivery Artifacts\n\n"
    text += "- `docs/dashboard.html`: static web dashboard generated by Cangjie\n"
    text += "- `docs/final_check.md`: final readiness report\n"
    text += "- `docs/match_trace.md`: source-backed operation trace\n"
    text += "- `docs/roadmap.md`: engineering roadmap\n"
    text += "- `docs/match_llm_request.md`: LLM request draft\n"
    text += "- `docs/source_map.md`: knowledge source distribution\n"
    text += "- `docs/command_sheet.md`: classroom command sheet\n\n"
    text += "## Acceptance Alignment\n\n"
    text += "- Import/add knowledge: supported by add/import commands.\n"
    text += "- Retrieve sources: supported by sources, show-source, why-source, trace.\n"
    text += "- Answer questions: supported by ask, session, study-plan, card, quiz, example.\n"
    text += "- Show sources: primary source and context are visible in source-backed outputs.\n"
    text += "- Cangjie engineering: all project feature code is written in Cangjie.\n"
    return text
}

func printDeliveryIndex(officialCount: Int64, userNotesCount: Int64, officialCharacters: Int64, userNotesCharacters: Int64): Unit {
    println(buildDeliveryIndexReport(officialCount, userNotesCount, officialCharacters, userNotesCharacters))
}

func exportDeliveryIndex(name: String, officialCount: Int64, userNotesCount: Int64, officialCharacters: Int64, userNotesCharacters: Int64): Path {
    let path = Path("docs").join(name + ".md")
    File.writeTo(path, buildDeliveryIndexReport(officialCount, userNotesCount, officialCharacters, userNotesCharacters).toArray())
