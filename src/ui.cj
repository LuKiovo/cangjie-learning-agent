func buildRubricReport(): String {
    var text = "# Cangjie Learning Agent Rubric\n\n"
    text += "## Scoring Dimensions\n\n"
    text += "| Dimension | Evidence | Status |\n"
    text += "| --- | --- | --- |\n"
    text += "| Cangjie implementation | All feature code is under `src/*.cj` | Ready |\n"
    text += "| Local knowledge base | `knowledge_base/official` and `knowledge_base/user_notes` | Ready |\n"
    text += "| Add/import knowledge | `add-*` and `import-*` commands | Ready |\n"
    text += "| Retrieval and sources | `sources`, `show-source`, `why-source`, `trace` | Ready |\n"
    text += "| Syntax answering | `ask`, `session`, `study-plan`, `card` | Ready |\n"
    text += "| Practice support | `example`, `practice`, `quiz`, `fix-error` | Ready |\n"
    text += "| LLM API | `llm-status`, `llm-ask`, `prompt`, `llm-request` | Ready |\n"
    text += "| Interface artifact | `export-dashboard dashboard` | Static web ready |\n"
    text += "| Final delivery | `final-check`, `delivery-index`, `command-sheet` | Ready |\n\n"
    text += "## Notes\n\n"
    text += "- Live API calls require curl plus environment variables for model and API key.\n"
    text += "- The implementation demonstrates the agent engineering path: retrieval, prompt construction, source trace, live request, output export, and response archive.\n"
    return text
}

func printRubric(): Unit {
    println(buildRubricReport())
}

func exportRubric(name: String): Path {
    let path = Path("docs").join(name + ".md")
    File.writeTo(path, buildRubricReport().toArray())
    return path
}

func buildTeacherSummaryReport(officialCount: Int64, userNotesCount: Int64): String {
    var text = "# Teacher Summary\n\n"
    text += "This project is a Cangjie Learning Agent for beginners. It is implemented with Cangjie source files and uses a local `.md/.txt` knowledge base for source-backed syntax help.\n\n"
    text += "## What It Demonstrates\n\n"
    text += "- Local official/course knowledge and personalized notes.\n"
    text += "- Retrieval, source scoring, primary source selection, and source context display.\n"
    text += "- Syntax answer, example, practice, quiz, study card, and learning session generation.\n"
    text += "- LLM request draft and live API call construction without storing API keys.\n"
    text += "- Static HTML dashboard and Markdown delivery artifacts generated by Cangjie.\n\n"
    text += "## Current Knowledge Base\n\n"
    text += "- Official/course files: ${officialCount}\n"
    text += "- User knowledge files: ${userNotesCount}\n\n"
    text += "## Suggested Review Commands\n\n"
    text += "```powershell\n"
    text += "target\\manual\\main.exe self-check\n"
    text += "target\\manual\\main.exe trace match\n"
    text += "target\\manual\\main.exe ask match\n"
    text += "target\\manual\\main.exe llm-request match\n"
    text += "target\\manual\\main.exe export-dashboard dashboard\n"
    text += "```\n"
    return text
}

func printTeacherSummary(officialCount: Int64, userNotesCount: Int64): Unit {
    println(buildTeacherSummaryReport(officialCount, userNotesCount))
}

func exportTeacherSummary(name: String, officialCount: Int64, userNotesCount: Int64): Path {
    let path = Path("docs").join(name + ".md")
    File.writeTo(path, buildTeacherSummaryReport(officialCount, userNotesCount).toArray())
    return path
}

func buildRehearsalReport(): String {
    var text = "# Classroom Rehearsal Checklist\n\n"
    text += "## Before Class\n\n"
    text += "- Build the project with `cjc -p src --output-dir target\\manual`.\n"
    text += "- Run `target\\manual\\main.exe self-check`.\n"
    text += "- Open `docs/dashboard.html` in a browser if a visual page is needed.\n"
    text += "- Keep `docs/command_sheet.md` open as the command checklist.\n\n"
    text += "## Live Demo\n\n"
    text += "1. Show `version` and `summary`.\n"
    text += "2. Show knowledge distribution with `source-map`.\n"
    text += "3. Show operation logic with `trace match`.\n"
    text += "4. Answer a syntax question with `ask match`.\n"
    text += "5. Show LLM preparation with `llm-request match`.\n"
    text += "6. Show final readiness with `final-check`.\n\n"
    text += "## Backup Plan\n\n"
    text += "- If GitHub push fails, explain that local commits are ready and use `git push` when the network is available.\n"
    text += "- If a browser is unavailable, use `dashboard` and `final-check` CLI output instead of the HTML page.\n"
    return text
}

func printRehearsal(): Unit {
    println(buildRehearsalReport())
}

func exportRehearsal(name: String): Path {
    let path = Path("docs").join(name + ".md")
    File.writeTo(path, buildRehearsalReport().toArray())
    return path
}
